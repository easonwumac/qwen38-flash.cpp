+      auto pool = metal::new_scoped_memory_pool();
+      buf->release();
+      throw std::runtime_error(
+          "[metal::make_buffer] Strict memory limit exceeded by imported buffer.");
+    }
+  }
   residency_sets_.insert(buf);
